#!/usr/bin/env python
from pathlib import Path
import sys


def get_lines(p: Path) -> list[str]:
    with p.open() as file:
        return [line.strip() for line in file]


def main() -> None:
    paths = [Path(p) for p in sys.argv[1:]]

    assert len(paths) == 2
    for path in paths:
        assert path.exists()

    f1, f2 = paths
    p1, p2 = map(get_lines, paths)

    p1s = set(p1)
    p2s = set(p2)

    if (a := len(p1)) != (b := len(p1s)):
        print(f"{f1} has duplicate entries: {a} vs. {b} lines")

    if (a := len(p2)) != (b := len(p2s)):
        print(f"{f2} has duplicate entries: {a} vs. {b} lines")

    p1m2 = p1s - p2s
    p2m1 = p2s - p1s

    if p1m2:
        print(f"Unique to {f1}:")
        print(*sorted(p1m2), sep='\n')

    if p2m1:
        print(f"Unique to {f2}:")
        print(*sorted(p2m1), sep='\n')


if __name__ == '__main__':
    main()
