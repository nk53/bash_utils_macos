#!/bin/bash
# newpy — scaffold a python CLI: newpy [-d DIR] name [interpreter]
set -u

dir="$HOME/bin"
while getopts d: opt; do
    case $opt in
        d) dir="$OPTARG" ;;
        *) exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [ -z "$1" ]; then
    echo "Usage: $(basename "$0") [-d DIR] new_program_name [interpreter]"
    exit 1
fi

dest="$dir/$1"
if [ -e "$dest" ]; then
    echo "$dest already exists"
    exit 1
fi

echo "Creating $dest ..."
printf '#!%s\n' "${2:-/usr/bin/env python3}" > "$dest"
cat <<'END' >> "$dest"


def main() -> None:
    pass


if __name__ == '__main__':
    main()
END
chmod +x "$dest"

${EDITOR:-vim} "$dest"
