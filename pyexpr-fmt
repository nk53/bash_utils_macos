#!/usr/bin/env python
import numbers
import sys
from math import *  # noqa; make all math available by eval
from argparse import ArgumentParser, Namespace


def get_args() -> Namespace:
    parser = ArgumentParser(description="Does what bash's `let` ought to do.")
    parser.add_argument('-e', action='store_true',
                        help="turns an expression like `1 + 1` into `1 + 1 = 2`")
    parser.add_argument('token', nargs='*',
                        help="all tokens are concatenated with ' '")

    args = parser.parse_args()
    return args


def get_exprs(args: Namespace) -> list[str]:
    expr = ' '.join(args.token)

    if expr:
        return [expr]

    return [line.strip() for line in sys.stdin]


def main() -> None:
    args = get_args()
    exprs = get_exprs(args)

    equation: bool = args.e

    for expr in exprs:
        try:
            result = eval(expr)
        except Exception as e:
            print(e)
            print(f'expr: {expr}')
            sys.exit(1)

        if isinstance(result, numbers.Number):
            result = f"{result:,}"

        if equation:
            print(f"{expr} = {result}")
        else:
            print(result)


if __name__ == '__main__':
    main()
