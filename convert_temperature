#!/usr/bin/env python
"""CLI for _local.temperature.Temperature"""
import argparse
from _local.temperature import Temperature, Abbr, _as_abbr


def _temperature_unit(v: str) -> Abbr:
    """less picky than _as_abbr; accepts lowercase abbreviation"""
    if len(v) == 1:
        v = v.upper()

    return _as_abbr(v)


parser = argparse.ArgumentParser(
    description="Convert between Celcius and Fahrenheit")
parser.add_argument('-v', '--verbose', action='store_true')
parser.add_argument('from', type=Temperature)
parser.add_argument('to', type=_as_abbr)

args = parser.parse_args()

_from: Temperature = args.__dict__['from']
to: Abbr = args.to

converted = _from.to(to)

if args.verbose:
    print(f"{_from} = {converted}")
else:
    print(converted)
