#!/usr/bin/env python
"""Note that this only works for Enums defined with types that can be
recreated from repr()
"""
import enum
import sys
import importlib

tpl_outer = "type {} = Literal[\n{}]"
tpl_inner = "    \"{}\",\n"
module = importlib.import_module(sys.argv[1])

converted: list = []

for name, value in vars(module).items():
    if name.startswith('_'):
        continue

    if value.__module__ != sys.argv[1]:
        continue

    if issubclass(value, enum.Enum):
        assert hasattr(value, '_member_map_')
        literals = map(str, value._member_map_.values())
        converted.append(
            tpl_outer.format(
                name,
                ''.join(tpl_inner.format(v) for v in literals)
            )
        )

print("from typing import Literal", *converted, sep='\n\n')
