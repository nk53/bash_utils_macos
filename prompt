#!/usr/bin/env python
import argparse
import json
from urllib.request import Request, urlopen

BASE_URL = "http://localhost:4096/session"  # TODO: get this from env or arg


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Facilitates prompting an existing opencode session")
    parser.add_argument('-m', '--show-metadata', action='store_true',
                        help="Show the complete JSON response")
    parser.add_argument('-t', '--show-thinking', action='store_true',
                        help="Show <thinking></thinking> text")
    parser.add_argument('session_id')
    parser.add_argument('prompt', nargs='+')
    args = parser.parse_args()

    url = f"{BASE_URL}/{args.session_id}/message"
    payload = {"parts": [{"type": "text", "text": ' '.join(args.prompt)}]}
    request = Request(
        url,
        data=json.dumps(payload).encode('utf-8'),
        headers={'Content-Type': 'application/json'})

    with urlopen(request) as response:
        try:
            status = f"{response.status} {response.reason}"
        except AttributeError:
            status = f"{response.getcode()}"

        body = response.read().decode('utf-8', errors='replace')
        print(status)
        try:
            data = json.loads(body)
            if args.metadata:
                print(json.dumps(data, indent=4))
            else:
                for part in data.get('parts', []):
                    text = part.get("text", "")
                    match part.get('type'):
                        case "reasoning":
                            print("<thinking>")
                            print(text)
                            print("</thinking>")
                        case "text":
                            print(text)
        except Exception:
            print(body)


if __name__ == '__main__':
    main()
